<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Job Application</title>

    <style>
        body {
            font-family: Arial;
            margin: 40px
        }

        fieldset {
            margin-bottom: 30px;
            padding: 20px
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        input,
        select {
            height: 28px;
            width: 200px
        }

        textarea {
            width: 100%;
            height: 60px
        }

        button {
            padding: 6px 10px
        }
    </style>

</head>

<body>


    <form method="POST" action="/add">

        <!-- BASIC DETAILS -->
        <fieldset>
            <legend>Basic Details</legend>

            <table>
               
                <tr>
                    <td>First Name</td>
                    
                    <td><input type="text" name="first_name" required></td>

                    <td>Middle Name</td>
                    <td><input type="text" name="middle_name"></td>

                    <td>Surname</td>
                    <td><input type="text" name="surname" required></td>
                </tr>

                <tr>
                    <td>Email</td>
                    <td><input type="email" name="email" required></td>

                    <td>Phone</td>
                    <td><input type="text" name="phone_number" required></td>

                    <td>Date of Birth</td>
                    <td><input type="date" name="date_of_birth" required></td>
                </tr>

                <tr>

                    <td>Gender</td>
                    <td>
                        <select name="gender_id">
                            <% genders.forEach(g=>{ %>
                                <option value="<%= g.gender_id %>">
                                    <%= g.gender_name %>
                                </option>
                                <% }) %>
                        </select>
                    </td>

                    <td>Marital Status</td>
                    <td>
                        <select name="marital_status_id">
                            <% maritalStatuses.forEach(m=>{ %>
                                <option value="<%= m.marital_status_id %>">
                                    <%= m.marital_status_name %>
                                </option>
                                <% }) %>
                        </select>
                    </td>

                    <td>Country</td>
                    <td><input type="text" name="country" value="India"></td>

                </tr>

                <tr>
                    <td>Address Line 1</td>
                    <td colspan="5"><textarea name="address_line1"></textarea></td>
                </tr>

                <tr>
                    <td>Address Line 2</td>
                    <td colspan="5"><textarea name="address_line2"></textarea></td>
                </tr>

                <tr>

                    <td>State</td>
                    <td><select onchange="generateCities()" name="state">
                            <% states.forEach(s=> { %>
                                <option value="<%= s.state_id %>">
                                    <%=s.state_name%>
                                </option>
                                <% }); %>
                        </select></td>
                    <td>city</td>
                    <td><select name="city">

                        </select></td>

                    <td>Postal Code</td>
                    <td><input type="text" name="postal_code"></td>

                </tr>

                <tr>

                    <td>Current Designation</td>
                    <td><input type="text" name="current_designation"></td>

                    <td>Total Experience</td>
                    <td><input type="number" step="0.1" name="total_experience_years"></td>

                </tr>

            </table>
        </fieldset>

        <!-- EDUCATION -->
        <fieldset>
            <legend>Education Details</legend>

            <table>

                <tr>
                    <th>Course</th>
                    <th>Board/University</th>
                    <th>Year</th>
                    <th>Percentage</th>
                </tr>

                <tr>

                    <td>
                        <select name="education[0][course_type_id]">
                            <% courseTypes.forEach(c=>{ %>
                                <% if (c.course_type_name==='SSC' ) { %>
                                    <option value="<%= c.course_type_id %>">
                                        <%= c.course_type_name %>
                                    </option>
                                    <% }}) %>
                        </select>
                    </td>

                    <td><input type="text" name="education[0][board_or_uni]"></td>
                    <td><input type="text" name="education[0][year]"></td>
                    <td><input type="number" name="education[0][percentage]"></td>

                </tr>

                <tr>

                    <td>
                        <select name="education[1][course_type_id]">
                            <% courseTypes.forEach(c=>{ %>
                                <% if (c.course_type_name==='HSC' ) { %>
                                    <option value="<%= c.course_type_id %>">
                                        <%= c.course_type_name %>
                                    </option>
                                    <% }}) %>
                        </select>
                    </td>

                    <td><input type="text" name="education[1][board_or_uni]"></td>
                    <td><input type="text" name="education[1][year]"></td>
                    <td><input type="number" name="education[1][percentage]"></td>

                </tr>


                <tr>

                    <td>
                        <select name="education[2][course_type_id]">
                            <% courseTypes.forEach(c=>{ %>
                                <% if(!(c.course_type_name==='SSC' || c.course_type_name==='HSC' )) {%>
                                    <option value="<%= c.course_type_id %>">
                                        <%= c.course_type_name %>
                                    </option>
                                    <% }}) %>
                        </select>
                    </td>

                    <td><input type="text" name="education[2][board_or_uni]"></td>
                    <td><input type="text" name="education[2][year]"></td>
                    <td><input type="number" name="education[2][percentage]"></td>

                </tr>

                <tr>

                    <td>
                        <select name="education[3][course_type_id]">
                            <% courseTypes.forEach(c=>{ %>
                                <% if(!(c.course_type_name==='SSC' || c.course_type_name==='HSC' )) {%>
                                    <option value="<%= c.course_type_id %>">
                                        <%= c.course_type_name %>
                                    </option>
                                    <% }}) %>
                        </select>
                    </td>

                    <td><input type="text" name="education[3][board_or_uni]"></td>
                    <td><input type="text" name="education[3][year]"></td>
                    <td><input type="number" name="education[3][percentage]"></td>

                </tr>


            </table>
        </fieldset>


        <!-- WORK EXPERIENCE -->
        <fieldset>

            <legend>Work Experience</legend>

            <table border="1" id="workTable">

                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Designation</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>

                        <td><input type="text" name="work[0][company_name]"></td>
                        <td><input type="text" name="work[0][designation]"></td>
                        <td><input type="date" name="work[0][start_date]"></td>
                        <td><input type="date" name="work[0][end_date]"></td>

                        <td>
                            <button type="button" onclick="removeWork(this)">Remove</button>
                        </td>

                    </tr>

                </tbody>

            </table>

            <br>

            <button type="button" onclick="addWork()">Add Work</button>

        </fieldset>


        <!-- LANGUAGES -->
        <fieldset>

            <legend>Languages Known</legend>

            <table border="1">

                <tr>
                    <th>Language</th>
                    <th>Read</th>
                    <th>Write</th>
                    <th>Speak</th>
                </tr>

                <% languages.forEach((l,i)=>{ %>

                    <tr>

                        <td>
                            <%= l.language_name %>

                                <input type="hidden" name="languages[<%= i %>][language_id]"
                                    value="<%= l.language_id %>">

                        </td>

                        <td>
                            <input type="checkbox" name="languages[<%= i %>][read]" value="1">
                        </td>

                        <td>
                            <input type="checkbox" name="languages[<%= i %>][write]" value="1">
                        </td>

                        <td>
                            <input type="checkbox" name="languages[<%= i %>][speak]" value="1">
                        </td>

                    </tr>

                    <% }) %>

            </table>

        </fieldset>


        <!-- TECHNOLOGIES -->
        <!-- <fieldset>

            <legend>Technologies</legend>

            <table border="1">

                <tr>
                    <th>Technology</th>

                    <% proficiencyLevels.forEach(p=>{ %>
                        <th>
                            <%= p.proficiency_level_name %>
                        </th>
                        <% }) %>

                </tr>

                <% technologies.forEach((t,i)=>{ %>

                    <tr>

                        <td>
                            <%= t.technology_name %>
                                <input type="hidden" name="technologies[<%= i %>][technology_id]"
                                    value="<%= t.technology_id %>">
                        </td>

                        <% proficiencyLevels.forEach(p=>{ %>

                            <td>
                                <input type="radio" name="technologies[<%= i %>][proficiency_level_id]"
                                    value="<%= p.proficiency_level_id %>">
                            </td>

                            <% }) %>

                    </tr>

                    <% }) %>

            </table>

        </fieldset> -->


        <fieldset>

            <legend>Technologies</legend>

            <table id="techtable" border="1">

                <tr>
                    <th>Technology</th>

                    <% proficiencyLevels.forEach(p=>{ %>
                        <th>
                            <%= p.proficiency_level_name %>
                        </th>
                        <% }) %>

                </tr>
                <tbody>
                    <tr>
                        <td>
                            <select name="technologies[0][technology_id]">
                                <% technologies.forEach(t=>{ %>
                                    <option value="<%= t.technology_id %>">
                                        <%= t.technology_name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </td>
                        <% proficiencyLevels.forEach(p=>{ %>
                            <td><input type="radio" name="technologies[0][proficiency_level_id]"
                                    value="<%= p.proficiency_level_id %>"></td>
                            <% }) %>
                    </tr>
                </tbody>
            </table>
            <br>

            <button type="button" onclick="addTech()">Add Technology</button>
        </fieldset>


        <!-- REFERENCES -->
        <fieldset>

            <legend>References</legend>

            <table>

                <tr>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Designation</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Relation</th>
                </tr>

                <tr>

                    <td><input type="text" name="references[0][name]"></td>
                    <td><input type="text" name="references[0][company]"></td>
                    <td><input type="text" name="references[0][designation]"></td>
                    <td><input type="text" name="references[0][phone]"></td>
                    <td><input type="email" name="references[0][email]"></td>

                    <td>
                        <select name="references[0][relationship_id]">
                            <% referenceRelationships.forEach(r=>{ %>
                                <option value="<%= r.reference_relationship_id %>">
                                    <%= r.relationship_name %>
                                </option>
                                <% }) %>
                        </select>
                    </td>

                </tr>

                <tr>

                    <td><input type="text" name="references[1][name]"></td>
                    <td><input type="text" name="references[1][company]"></td>
                    <td><input type="text" name="references[1][designation]"></td>
                    <td><input type="text" name="references[1][phone]"></td>
                    <td><input type="email" name="references[1][email]"></td>

                    <td>
                        <select name="references[1][relationship_id]">
                            <% referenceRelationships.forEach(r=>{ %>
                                <option value="<%= r.reference_relationship_id %>">
                                    <%= r.relationship_name %>
                                </option>
                                <% }) %>
                        </select>
                    </td>

                </tr>

            </table>

        </fieldset>


        <br>

        <button type="submit">Submit Application</button>

    </form>


    <script>

        async function generateCities() {
            const stateId = document.getElementsByName("state")[0].value;
            const citySelect = document.getElementsByName("city")[0];

            // Fetch filtered cities from your server
            const response = await fetch(`/combos/city/${stateId}`);
            const cities = await response.json();

            // Clear and repopulate the dropdown
            citySelect.innerHTML = '<option value="">Select a city</option>';
            cities.forEach(c => {
                const option = document.createElement("option");
                option.value = c.city_id;
                option.textContent = c.city_name;
                citySelect.appendChild(option);
            });
        }

        let workIndex = 0

        function addWork() {

            workIndex++

            let tbody = document.querySelector("#workTable tbody")

            let row = document.createElement("tr")

            row.innerHTML = `

<td><input type="text" name="work[${workIndex}][company_name]"></td>
<td><input type="text" name="work[${workIndex}][designation]"></td>
<td><input type="date" name="work[${workIndex}][start_date]"></td>
<td><input type="date" name="work[${workIndex}][end_date]"></td>

<td>
<button type="button" onclick="removeWork(this)">Remove</button>
</td>

`

            tbody.appendChild(row)

        }

        function removeWork(btn) {
            btn.parentNode.parentNode.remove()
        }

        let techIndex = 0
        function addTech() {
            techIndex++
            console.log(techIndex);


            let tbody = document.querySelector("#techtable tbody")
            let row = document.createElement("tr")
            row.innerHTML = `
             
                        <td>
                            <select name="technologies[${techIndex}][technology_id]">
                                <% technologies.forEach(t=>{ %>
                                    <option value="<%= t.technology_id %>">
                                        <%= t.technology_name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </td>
                        <% proficiencyLevels.forEach(p=>{ %>
                            <td><input type="radio" name="technologies[${techIndex}][proficiency_level_id]"
                                    value="<%= p.proficiency_level_id %>"></td>
                            <% }) %>
                
            `
            tbody.appendChild(row)

        }
    </script>

</body>

</html>