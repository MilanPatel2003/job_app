<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Update Job Application</title>
    <style>
        body { font-family: Arial; margin: 40px }
        fieldset { margin-bottom: 30px; padding: 20px }
        table { width: 100%; border-collapse: collapse; }
        input, select { height: 28px; width: 200px }
        textarea { width: 100%; height: 60px }
        button { padding: 6px 10px }
    </style>
</head>
<body>
 <form method="POST" action="/update/<%= basic.applicant_id %>">        
        <input type="hidden" name="applicant_id" value="<%= basic.applicant_id %>">
        <!-- Hidden fields to pass server-side array lengths to client-side JS -->
<input type="hidden" id="workCount" value="<%= work.length %>">
<input type="hidden" id="techCount" value="<%= applicant_technologies.length %>">

        <!-- BASIC DETAILS -->
        <fieldset>
            <legend>Basic Details</legend>
            <table>
                <tr>
                    <td>First Name</td>
                    <td><input type="text" name="first_name" value="<%= basic.first_name %>" required></td>
                    <td>Middle Name</td>
                    <td><input type="text" name="middle_name" value="<%= basic.middle_name || '' %>"></td>
                    <td>Surname</td>
                    <td><input type="text" name="surname" value="<%= basic.surname %>" required></td>
                </tr>
                <tr>
                    <td>Email</td>
                    <td><input type="email" name="email" value="<%= basic.email %>" required></td>
                    <td>Phone</td>
                    <td><input type="text" name="phone_number" value="<%= basic.phone_number %>" required></td>
                    <td>Date of Birth</td>
                    <td><input type="date" name="date_of_birth" value="<%= basic.date_of_birth %>" required></td>
                </tr>
                <tr>
                    <td>Gender</td>
                    <td>
                        <select name="gender_id">
                            <% genders.forEach(g=>{ %>
                                <option value="<%= g.gender_id %>" <%= g.gender_id == basic.gender_id ? 'selected' : '' %>>
                                    <%= g.gender_name %>
                                </option>
                            <% }) %>
                        </select>
                    </td>
                    <td>Marital Status</td>
                    <td>
                        <select name="marital_status_id">
                            <% maritalStatuses.forEach(m=>{ %>
                                <option value="<%= m.marital_status_id %>" <%= m.marital_status_id == basic.marital_status_id ? 'selected' : '' %>>
                                    <%= m.marital_status_name %>
                                </option>
                            <% }) %>
                        </select>
                    </td>
                    <td>Country</td>
                    <td><input type="text" name="country" value="<%= basic.country || 'India' %>"></td>
                </tr>
                <tr>
                    <td>Address Line 1</td>
                    <td colspan="5"><textarea name="address_line1"><%= basic.address_line1 || '' %></textarea></td>
                </tr>
                <tr>
                    <td>Address Line 2</td>
                    <td colspan="5"><textarea name="address_line2"><%= basic.address_line2 || '' %></textarea></td>
                </tr>
                <tr>
                    <td>State</td>
                    <td>
                        <select onchange="generateCities()" name="state" id="stateSelect">
                            <% states.forEach(s=> { %>
                                <option value="<%= s.state_id %>" <%= s.state_id == basic.state ? 'selected' : '' %>>
                                    <%= s.state_name %>
                                </option>
                            <% }); %>
                        </select>
                    </td>
                    <td>City</td>
                    <td>
                        <select name="city" id="citySelect">
                            <option value="">Select a city</option>
                        </select>
                    </td>
                    <td>Postal Code</td>
                    <td><input type="text" name="postal_code" value="<%= basic.postal_code || '' %>"></td>
                </tr>
                <tr>
                    <td>Current Designation</td>
                    <td><input type="text" name="current_designation" value="<%= basic.current_designation || '' %>"></td>
                    <td>Total Experience</td>
                    <td><input type="number" step="0.1" name="total_experience_years" value="<%= basic.total_experience_years || '' %>"></td>
                </tr>
            </table>
        </fieldset>

        <!-- EDUCATION -->
        <fieldset>
            <legend>Education Details</legend>
            <table>
                <tr><th>Course</th><th>Board/University</th><th>Year</th><th>Percentage</th></tr>
                <% 
                const getEdu = (name) => education.find(e => {
                    const ct = courseTypes.find(c => c.course_type_id == e.course_type_id);
                    return ct?.course_type_name === name;
                });
                const ssc = getEdu('SSC'), hsc = getEdu('HSC');
                const others = education.filter(e => {
                    const ct = courseTypes.find(c => c.course_type_id == e.course_type_id);
                    return ct && !['SSC','HSC'].includes(ct.course_type_name);
                });
                %>
                <!-- SSC -->
                <tr>
                    <td>
                        <select name="education[0][course_type_id]">
                            <% courseTypes.forEach(c=>{ if(c.course_type_name==='SSC'){ %>
                                <option value="<%=c.course_type_id%>" <%=ssc?.course_type_id==c.course_type_id?'selected':''%>>
                                    <%=c.course_type_name%>
                                </option>
                            <% }}) %>
                        </select>
                    </td>
                    <td><input type="text" name="education[0][board_or_uni]" value="<%=ssc?.board_or_university||''%>"></td>
                    <td><input type="text" name="education[0][year]" value="<%=ssc?.passing_year||''%>"></td>
                    <td><input type="number" name="education[0][percentage]" value="<%=ssc?.percentage||''%>"></td>
                </tr>
                <!-- HSC -->
                <tr>
                    <td>
                        <select name="education[1][course_type_id]">
                            <% courseTypes.forEach(c=>{ if(c.course_type_name==='HSC'){ %>
                                <option value="<%=c.course_type_id%>" <%=hsc?.course_type_id==c.course_type_id?'selected':''%>>
                                    <%=c.course_type_name%>
                                </option>
                            <% }}) %>
                        </select>
                    </td>
                    <td><input type="text" name="education[1][board_or_uni]" value="<%=hsc?.board_or_university||''%>"></td>
                    <td><input type="text" name="education[1][year]" value="<%=hsc?.passing_year||''%>"></td>
                    <td><input type="number" name="education[1][percentage]" value="<%=hsc?.percentage||''%>"></td>
                </tr>
                <!-- Others (2 slots) -->
                <% for(let i=0;i<2;i++){ const e=others[i]; %>
                <tr>
                    <td>
                        <select name="education[<%=i+2%>][course_type_id]">
                            <% courseTypes.forEach(c=>{ if(!['SSC','HSC'].includes(c.course_type_name)){ %>
                                <option value="<%=c.course_type_id%>" <%=e?.course_type_id==c.course_type_id?'selected':''%>>
                                    <%=c.course_type_name%>
                                </option>
                            <% }}) %>
                        </select>
                    </td>
                    <td><input type="text" name="education[<%=i+2%>][board_or_uni]" value="<%=e?.board_or_university||''%>"></td>
                    <td><input type="text" name="education[<%=i+2%>][year]" value="<%=e?.passing_year||''%>"></td>
                    <td><input type="number" name="education[<%=i+2%>][percentage]" value="<%=e?.percentage||''%>"></td>
                </tr>
                <% } %>
            </table>
        </fieldset>

        <!-- WORK EXPERIENCE -->
        <fieldset>
            <legend>Work Experience</legend>
            <table border="1" id="workTable">
                <thead><tr><th>Company</th><th>Designation</th><th>From</th><th>To</th><th>Action</th></tr></thead>
                <tbody>
                    <% work.forEach((w,i)=>{ %>
                    <tr>
                        <td><input type="text" name="work[<%=i%>][company_name]" value="<%=w.company_name%>"></td>
                        <td><input type="text" name="work[<%=i%>][designation]" value="<%=w.designation%>"></td>
                        <td><input type="date" name="work[<%=i%>][start_date]" value="<%=w.start_date%>"></td>
                        <td><input type="date" name="work[<%=i%>][end_date]" value="<%=w.end_date||''%>"></td>
                        <td><button type="button" onclick="removeWork(this)">Remove</button></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <br><button type="button" onclick="addWork()">Add Work</button>
        </fieldset>

        <!-- LANGUAGES -->
        <fieldset>
            <legend>Languages Known</legend>
            <table border="1">
                <tr><th>Language</th><th>Read</th><th>Write</th><th>Speak</th></tr>
                <% languages.forEach((l,i)=>{ 
                    const ul = applicant_languages.find(al=>al.language_id==l.language_id);
                %>
                <tr>
                    <td><%=l.language_name%><input type="hidden" name="languages[<%=i%>][language_id]" value="<%=l.language_id%>"></td>
                    <td><input type="checkbox" name="languages[<%=i%>][read]" value="1" <%=ul?.can_read?'checked':''%>></td>
                    <td><input type="checkbox" name="languages[<%=i%>][write]" value="1" <%=ul?.can_write?'checked':''%>></td>
                    <td><input type="checkbox" name="languages[<%=i%>][speak]" value="1" <%=ul?.can_speak?'checked':''%>></td>
                </tr>
                <% }) %>
            </table>
        </fieldset>

        <!-- TECHNOLOGIES -->
        <fieldset>
            <legend>Technologies</legend>
            <table id="techtable" border="1">
                <tr>
                    <th>Technology</th>
                    <% proficiencyLevels.forEach(p=>{ %><th><%=p.proficiency_level_name%></th><% }) %>
                </tr>
                <tbody>
                    <% applicant_technologies.forEach((t,i)=>{ %>
                    <tr>
                        <td>
                            <select name="technologies[<%=i%>][technology_id]">
                                <% technologies.forEach(tech=>{ %>
                                    <option value="<%=tech.technology_id%>" <%=tech.technology_id==t.technology_id?'selected':''%>>
                                        <%=tech.technology_name%>
                                    </option>
                                <% }) %>
                            </select>
                        </td>
                        <% proficiencyLevels.forEach(p=>{ %>
                            <td><input type="radio" name="technologies[<%=i%>][proficiency_level_id]" value="<%=p.proficiency_level_id%>" <%=p.proficiency_level_id==t.proficiency_level_id?'checked':''%>></td>
                        <% }) %>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <br><button type="button" onclick="addTech()">Add Technology</button>
        </fieldset>

        <!-- REFERENCES -->
        <fieldset>
            <legend>References</legend>
            <table>
                <tr><th>Name</th><th>Company</th><th>Designation</th><th>Phone</th><th>Email</th><th>Relation</th></tr>
                <% for(let i=0;i<2;i++){ const r=applicant_references[i]; %>
                <tr>
                    <td><input type="text" name="references[<%=i%>][name]" value="<%=r?.reference_name||''%>"></td>
                    <td><input type="text" name="references[<%=i%>][company]" value="<%=r?.company_name||''%>"></td>
                    <td><input type="text" name="references[<%=i%>][designation]" value="<%=r?.designation||''%>"></td>
                    <td><input type="text" name="references[<%=i%>][phone]" value="<%=r?.phone_number||''%>"></td>
                    <td><input type="email" name="references[<%=i%>][email]" value="<%=r?.email||''%>"></td>
                    <td>
                        <select name="references[<%=i%>][relationship_id]">
                            <% referenceRelationships.forEach(rel=>{ %>
                                <option value="<%=rel.reference_relationship_id%>" <%=r?.reference_relationship_id==rel.reference_relationship_id?'selected':''%>>
                                    <%=rel.relationship_name%>
                                </option>
                            <% }) %>
                        </select>
                    </td>
                </tr>
                <% } %>
            </table>
        </fieldset>

        <br><button type="submit">Update Application</button>
    </form>


<script>
    // Load cities on page load
    document.addEventListener('DOMContentLoaded', async function() {
        const stateId = document.getElementById('stateSelect')?.value;
        if (stateId) {
            await generateCities();
            const citySelect = document.getElementById('citySelect');
            const userCity = "<%= basic.city %>".replace(/"/g, '&quot;');
            if (userCity) citySelect.value = userCity;
        }
    });

    async function generateCities() {
        const stateId = document.getElementById('stateSelect').value;
        const citySelect = document.getElementById('citySelect');
        try {
            const res = await fetch(`/combos/city/${stateId}`);
            const cities = await res.json();
            citySelect.innerHTML = '<option value="">Select a city</option>';
            cities.forEach(c => {
                const opt = document.createElement("option");
                opt.value = c.city_id; 
                opt.textContent = c.city_name;
                citySelect.appendChild(opt);
            });
        } catch (err) {
            console.error('Failed to load cities:', err);
        }
    }

    let workIndex = parseInt(document.getElementById('workCount').value, 10) || 0;
    let techIndex = parseInt(document.getElementById('techCount').value, 10) || 0;

    // Work Experience
    function addWork() {
        workIndex++;
        const tbody = document.querySelector("#workTable tbody");
        const row = document.createElement("tr");
        row.innerHTML = `
            <td><input type="text" name="work[${workIndex}][company_name]" required></td>
            <td><input type="text" name="work[${workIndex}][designation]" required></td>
            <td><input type="date" name="work[${workIndex}][start_date]" required></td>
            <td><input type="date" name="work[${workIndex}][end_date]"></td>
            <td><button type="button" onclick="removeWork(this)">Remove</button></td>
        `;
        tbody.appendChild(row);
    }

    function removeWork(btn) { 
        const row = btn.closest('tr');
        row.remove();
        // Optional: re-index remaining rows if your backend expects sequential indices
    }

    // Technologies
    function addTech() {
        techIndex++;
        const tbody = document.querySelector("#techtable tbody");
        const row = document.createElement("tr");
        row.innerHTML = `
            <td>
                <select name="technologies[${techIndex}][technology_id]" required>
                    <% technologies.forEach(t=>{ %>
                        <option value="<%=t.technology_id%>"><%=t.technology_name%></option>
                    <% }) %>
                </select>
            </td>
            <% proficiencyLevels.forEach(p=>{ %>
                <td>
                    <input type="radio" name="technologies[${techIndex}][proficiency_level_id]" 
                           value="<%=p.proficiency_level_id%>" required>
                </td>
            <% }) %>
        `;
        tbody.appendChild(row);
    }
</script>
</body>
</html>