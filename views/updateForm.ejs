<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Update Job Application</title>

<style>
body { font-family: Arial; margin: 40px }
fieldset { margin-bottom: 30px; padding: 20px }
table { width: 100%; border-collapse: collapse; }
input, select { height: 28px; width: 200px }
textarea { width: 100%; height: 60px }
button { padding: 6px 10px }
</style>
</head>

<body>

<form method="POST" action="/update/<%= basic.applicant_id %>">
    <input type="hidden" id="workLength" value="<%= work.length %>">
<input type="hidden" id="techLength" value="<%= applicant_technologies.length %>">

<fieldset>
<legend>Basic Details</legend>

<table>
<tr>
<td>First Name</td>
<td><input type="text" name="first_name" value="<%= basic.first_name %>" required></td>

<td>Middle Name</td>
<td><input type="text" name="middle_name" value="<%= basic.middle_name || '' %>"></td>

<td>Surname</td>
<td><input type="text" name="surname" value="<%= basic.surname %>" required></td>
</tr>

<tr>
<td>Email</td>
<td><input type="email" name="email" value="<%= basic.email %>" required></td>

<td>Phone</td>
<td><input type="text" name="phone_number" value="<%= basic.phone_number %>" required></td>

<td>DOB</td>
<td><input type="date" name="date_of_birth" value="<%= basic.date_of_birth ? basic.date_of_birth.toISOString().split('T')[0] : '' %>" required></td>
</tr>

<tr>
<td>Gender</td>
<td>
<select name="gender_id">
<% genders.forEach(g=>{ %>
<option value="<%=g.gender_id%>" <%= g.gender_id==basic.gender_id?'selected':'' %>>
<%=g.gender_name%>
</option>
<% }) %>
</select>
</td>

<td>Marital</td>
<td>
<select name="marital_status_id">
<% maritalStatuses.forEach(m=>{ %>
<option value="<%=m.marital_status_id%>" <%= m.marital_status_id==basic.marital_status_id?'selected':'' %>>
<%=m.marital_status_name%>
</option>
<% }) %>
</select>
</td>

<td>Country</td>
<td><input type="text" name="country" value="<%= basic.country || 'India' %>"></td>
</tr>

<tr>
<td>Address 1</td>
<td colspan="5"><textarea name="address_line1"><%= basic.address_line1 || '' %></textarea></td>
</tr>

<tr>
<td>Address 2</td>
<td colspan="5"><textarea name="address_line2"><%= basic.address_line2 || '' %></textarea></td>
</tr>

<tr>
<td>State</td>
<td>
<select name="state" onchange="generateCities()" id="stateSelect">
<% states.forEach(s=>{ %>
<option value="<%=s.state_id%>" <%= s.state_id==basic.state?'selected':'' %>>
<%=s.state_name%>
</option>
<% }) %>
</select>
</td>

<td>City</td>
<td>
<select name="city" id="citySelect"></select>
</td>

<td>Postal</td>
<td><input type="text" name="postal_code" value="<%= basic.postal_code || '' %>"></td>
</tr>

<tr>
<td>Designation</td>
<td><input type="text" name="current_designation" value="<%= basic.current_designation || '' %>"></td>

<td>Experience</td>
<td><input type="number" name="total_experience_years" value="<%= basic.total_experience_years || '' %>"></td>
</tr>

</table>
</fieldset>

<fieldset>
<legend>Education</legend>

<table>
<tr><th>Course</th><th>Board</th><th>Year</th><th>%</th></tr>

<% for(let i=0;i<4;i++){ %>
<tr>

<td>
<select name="education[<%=i%>][course_type_id]">
<% courseTypes.forEach(c=>{ %>
<option value="<%=c.course_type_id%>" 
<%= education[i]?.course_type_id==c.course_type_id?'selected':'' %>>
<%=c.course_type_name%>
</option>
<% }) %>
</select>
</td>

<td><input type="text" name="education[<%=i%>][board_or_uni]" value="<%= education[i]?.board_or_university || '' %>"></td>
<td><input type="text" name="education[<%=i%>][year]" value="<%= education[i]?.passing_year || '' %>"></td>
<td><input type="number" name="education[<%=i%>][percentage]" value="<%= education[i]?.percentage || '' %>"></td>

</tr>
<% } %>

</table>
</fieldset>

<fieldset>
<legend>Work Experience</legend>

<table border="1" id="workTable">
<thead>
<tr><th>Company</th><th>Designation</th><th>From</th><th>To</th><th>Action</th></tr>
</thead>

<tbody>
<% work.forEach((w,i)=>{ %>
<tr>
<td><input name="work[<%=i%>][company_name]" value="<%=w.company_name%>"></td>
<td><input name="work[<%=i%>][designation]" value="<%=w.designation%>"></td>
<td><input type="date" name="work[<%=i%>][start_date]" value="<%= w.start_date ? w.start_date.toISOString().split('T')[0] : '' %>"
"></td>
<td><input type="date" name="work[<%=i%>][end_date]" value="<%= w.end_date ? w.end_date.toISOString().split('T')[0] : '' %>"></td>
<td><button type="button" onclick="removeWork(this)">Remove</button></td>
</tr>
<% }) %>
</tbody>
</table>

<br>
<button type="button" onclick="addWork()">Add Work</button>
</fieldset>

<fieldset>
<legend>Languages</legend>

<table border="1">
<tr><th>Lang</th><th>Read</th><th>Write</th><th>Speak</th></tr>

<% languages.forEach((l,i)=>{ 
const ul = applicant_languages.find(al=>al.language_id==l.language_id);
%>

<tr>
<td>
<%=l.language_name%>
<input type="hidden" name="languages[<%=i%>][language_id]" value="<%=l.language_id%>">
</td>

<td><input type="checkbox" name="languages[<%=i%>][read]" <%=ul?.can_read?'checked':''%>></td>
<td><input type="checkbox" name="languages[<%=i%>][write]" <%=ul?.can_write?'checked':''%>></td>
<td><input type="checkbox" name="languages[<%=i%>][speak]" <%=ul?.can_speak?'checked':''%>></td>
</tr>

<% }) %>
</table>
</fieldset>

<fieldset>
<legend>Technologies</legend>

<table id="techtable" border="1">
<tr>
<th>Tech</th>
<% proficiencyLevels.forEach(p=>{ %>
<th><%=p.proficiency_level_name%></th>
<% }) %>
</tr>

<tbody>
<% applicant_technologies.forEach((t,i)=>{ %>
<tr>

<td>
<select name="technologies[<%=i%>][technology_id]">
<% technologies.forEach(tech=>{ %>
<option value="<%=tech.technology_id%>" <%=tech.technology_id==t.technology_id?'selected':''%>>
<%=tech.technology_name%>
</option>
<% }) %>
</select>
</td>

<% proficiencyLevels.forEach(p=>{ %>
<td>
<input type="radio" 
name="technologies[<%=i%>][proficiency_level_id]" 
value="<%=p.proficiency_level_id%>"
<%=p.proficiency_level_id==t.proficiency_level_id?'checked':''%>>
</td>
<% }) %>

</tr>
<% }) %>
</tbody>
</table>

<br>
<button type="button" onclick="addTech()">Add Tech</button>
</fieldset>

<fieldset>
<legend>References</legend>

<table>
<tr><th>Name</th><th>Company</th><th>Designation</th><th>Phone</th><th>Email</th><th>Relation</th></tr>

<% for(let i=0;i<2;i++){ %>
<tr>
<td><input name="references[<%=i%>][name]" value="<%= applicant_references[i]?.reference_name || '' %>"></td>
<td><input name="references[<%=i%>][company]" value="<%= applicant_references[i]?.company_name || '' %>"></td>
<td><input name="references[<%=i%>][designation]" value="<%= applicant_references[i]?.designation || '' %>"></td>
<td><input name="references[<%=i%>][phone]" value="<%= applicant_references[i]?.phone_number || '' %>"></td>
<td><input name="references[<%=i%>][email]" value="<%= applicant_references[i]?.email || '' %>"></td>

<td>
<select name="references[<%=i%>][relationship_id]">
<% referenceRelationships.forEach(r=>{ %>
<option value="<%=r.reference_relationship_id%>" 
<%= applicant_references[i]?.reference_relationship_id==r.reference_relationship_id?'selected':'' %>>
<%=r.relationship_name%>
</option>
<% }) %>
</select>
</td>
</tr>
<% } %>

</table>
</fieldset>

<br>
<button type="submit">Update</button>

</form>

<script>
async function generateCities(){
const stateId=document.getElementById("stateSelect").value
const citySelect=document.getElementById("citySelect")

const res=await fetch(`/combos/city/${stateId}`)
const cities=await res.json()

citySelect.innerHTML='<option>Select</option>'

cities.forEach(c=>{
const opt=document.createElement("option")
opt.value=c.city_id
opt.textContent=c.city_name
if(c.city_id=="<%=basic.city%>") opt.selected=true
citySelect.appendChild(opt)
})
}

let workIndex = parseInt(document.getElementById("workLength").value) || 0;
function addWork(){
workIndex++
const tbody=document.querySelector("#workTable tbody")
const row=document.createElement("tr")

row.innerHTML=`
<td><input name="work[${workIndex}][company_name]"></td>
<td><input name="work[${workIndex}][designation]"></td>
<td><input type="date" name="work[${workIndex}][start_date]"></td>
<td><input type="date" name="work[${workIndex}][end_date]"></td>
<td><button type="button" onclick="removeWork(this)">Remove</button></td>
`

tbody.appendChild(row)
}

function removeWork(btn){
btn.closest("tr").remove()
}

let techIndex = parseInt(document.getElementById("techLength").value) || 0;
function addTech(){
techIndex++
const tbody=document.querySelector("#techtable tbody")
const row=document.createElement("tr")

row.innerHTML=`
<td>
<select name="technologies[${techIndex}][technology_id]">
<% technologies.forEach(t=>{ %>
<option value="<%=t.technology_id%>"><%=t.technology_name%></option>
<% }) %>
</select>
</td>

<% proficiencyLevels.forEach(p=>{ %>
<td><input type="radio" name="technologies[${techIndex}][proficiency_level_id]" value="<%=p.proficiency_level_id%>"></td>
<% }) %>
`

tbody.appendChild(row)
}

generateCities()
</script>

</body>
</html>